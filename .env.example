# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Postgres credentials for the docker-compose `db` service.
POSTGRES_USER=comparer
POSTGRES_PASSWORD=comparer
POSTGRES_DB=comparer

# Full database URL the app connects with (should match the values above).
DATABASE_URL=postgresql+psycopg://comparer:comparer@localhost:5432/comparer

# LLM provider API key (optional until the answering pipeline is built).
LLM_API_KEY=

# Embedding model identifier.
EMBEDDING_MODEL=text-embedding-3-small

# Hard monthly API spend ceiling, in USD.
MONTHLY_COST_CAP_USD=50

# Path to the corpus directory (defaults to <repo>/corpus if unset).
# CORPUS_DIR=/path/to/corpus
